<div id="block_44">
  <div class="new_order-block ">
<div class="bg"></div>
<div class="divider-top"></div>
<div class="divider-bottom"></div>
<div class="container-fluid">
  <div class="row">

  <div class="col-lg-7 mb-3">
<div class="component_form_group component_card component_radio_button">
<div class="card ">
{% if error %}
<div class="alert alert-dismissible alert-danger">
{{ errorText }}
</div>
{% endif %}

{% if data["order"]["success"] == 1 %}
<div class="order-success-card" id="order-success-card">
<center>
<img src="https://www.linkpicture.com/q/404-tick.png" alt="checkmark"></center>
<h2>Your order has been placed.</h2>
<div class="order-details">
<p>
<span class="service-name">
<b>Service :</b><br />{{data['order']['service']}}</span>
</p>
<p>
<span class="link"><b>Link :</b><br /><a href="{{data['order']['link']}}">{{data['order']['link']}}</a></span>
</p>
<p>
<span class="paid-amount"><b>You paid :</b>&nbsp;&nbsp;<span style="color:#7743DB">{{ data['order']['price'] }}</span></span><span class="quantity"><b>Quantity :</b>&nbsp;&nbsp;<span style="color:#E0144C">{{data['order']['quantity']}}</span></span>
</p>
</div>
<div class="user-details">
<p>
Order ID :&nbsp;&nbsp;{{data['order']['id']}}
</p>
<p>
Remaining balance :&nbsp;&nbsp;{{ data['order']['balance'] }}
</p>
</div>
<button type="button" onclick="closeOrderReceiptCard()">OK</button>
</div>

<script>

setTimeout(function() {
var el = $("#order-success-card");
el.addClass("order-success-card-active");
}, 1000);
function closeOrderReceiptCard() {

var el = document.getElementById("order-success-card");

el.classList.remove("order-success-card-active");
}
</script>

{% endif %}
{% if data["order"]["success"] == 2 %}
<div class="alert alert-dismissible alert-success">
<strong> {{ lang["neworder.success.id"] }}: </strong> {{ data['order']['id'] }} <br>
<strong> {{ lang["neworder.success.service"] }}: </strong> {{ data['order']['service'] }} <br>
<strong> {{ lang["neworder.success.username"] }}: </strong> {{ data['order']['link'] }} <br>
<strong> {{ lang["neworder.success.quantity"] }}: </strong> {{ data['order']['min'] }} - {{ data['order']['max'] }} <br>
<strong> {{ lang["neworder.success.posts"] }}: </strong> {{ data['order']['posts'] }} <br>
<strong> {{ lang["neworder.success.delay"] }}: </strong>{{ data['order']['delay'] }} <br>
</div>
{% endif %}



<form method="post" action="">
<div class="component_button_forms">
<div class="form-group">
<label for="orderformorderform-service" class="control-label">{{ lang["neworder.category"] }}</label>
<select class="form-control" id="neworder_category" name="categories" data-select="true" data-select-search="true" data-select-search-placeholder="Search" data-select-container="#select-category-container" tabindex="-1" aria-hidden="true">
{{ category_html_simplify }}

</select>
<div id="select-category-container" class="position-relative"></div>
</div>
</div>


<div class="form-group">
<label for="orderform-service" class="control-label">{{ lang["neworder.service"] }}</label>
<select class="form-control" id="neworder_services" name="services" data-select="true" data-select-search="true" data-select-search-placeholder="Search" data-select-container="#select-service-container" tabindex="-1" aria-hidden="true">
<option value="1">No services found in this category</option>
</select>
<div id="select-service-container" class="position-relative"></div>
</div>
<div id="neworder_fields"></div>


<div class="form-group" id="charge_div">
<label for="charge" class="control-label">{{ lang["neworder.charge"] }}</label>
<input type="text" class="form-control" id="charge" readonly>
</div>
<button type="submit" class="btn btn-block btn-primary">{{ lang["neworder.button"] }}</button>
</form>

</div>
   </div>
</div>
    

<div class="col-lg-5">
  <div class="component_content_card component_content_button component_content_headers">
{% if news %}
    <div class="card"style="max-height: 550px;">
      <div class="headsir"><i class="fal fa-newspaper mr-2"></i>Latest News</div>
      <div class="ssw">
      {% for new in news %}
      <div class="news-item">
        <div class="news-details">
          <p class="news-date"><i class="fad fa-calendar-alt mr-1" style="--fa-secondary-opacity: 0.65;"></i>{{ new['news_date'] }}</p>
          <h4 class="news-title">
            <span class="icon-container">
              <img width="30" class="news-icon-inline" src="{{ new['news_icon'] }}" alt="News Icon">
            </span>
            {{ new['news_title'] }}
          </h4>
          <div class="news-content">{{ new['news_content'] }}</div>
        </div>
      </div>
      {% endfor %}
      </div>
  </div>
  </div></div>{% endif%}
								</div>
							</div>
						</div>
					</div>	</div>
							
						

