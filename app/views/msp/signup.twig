                    <div class="loginSide">
					<form  action="" method="post">
					    {% if errorText %}
                            <div class="alert alert-dismissible alert-danger">
                              <button type="button" class="close" data-dismiss="alert">&times;</button>
                              {{ errorText }}
                            </div>
                          {% endif %}
                          {% if successText %}
                            <div class="alert alert-dismissible alert-success">
                              <button type="button" class="close" data-dismiss="alert">&times;</button>
                              {{ successText }}
                            </div>
                          {% endif %}
                        <div class="login-box">
						  	<div class="lgb-title">
                                Sign Up
                            </div>
                            <div class="lgb-text">
                                Your information is never shared with third parties.
                            </div>
                            <div class="fc-home">
                                <label for="regUsername"><span class="label-text">User name</span></label>
                                <input type="text" class="form-control" id="username" name="username" value="{{ data['username'] }}">
                            </div><!-- fc-home -->
							                            <div class="fc-home">
                                <label for="regName"><span class="label-text">Name</span></label>
                               <input type="text" class="form-control" id="firstname" name="name" value="{{ data['name'] }}">
                            </div><!-- fc-home -->
                            <div class="fc-home">
                                <label for="regSurname"><span class="label-text">Whatsapp No.</span></label>
                               <input type="text" class="form-control" id="skype" name="telephone" value="{{ data['telephone'] }}">
                            </div><!-- fc-home -->	
							                            <div class="fc-home">
                                <label for="regMail"><span class="label-text">E-Mail </span></label>
                                <input type="email" class="form-control" id="email" name="email" value="{{ data['email'] }}">
                            </div><!-- fc-home -->	
							                            <div class="fc-home">
                                <label for="regPass"><span class="label-text">Password</span></label>
                                <input type="password" class="form-control" id="password" name="password">
                            </div><!-- fc-home -->
                            <div class="fc-home">
                                <label for="reregPass"><span class="label-text">Repeat Password</span></label>
                                <input type="password" class="form-control" id="confirm" name="password_again">
                            </div><!-- fc-home -->
							{% if captcha %}
                                <div class="form-group">
                                  <div class="g-recaptcha" data-sitekey="{{ captchaKey }}"></div>
