                                                                <i class="far fa-tachometer-alt-slowest m-icon"></i>
                                                            </span>
                            <span class="text">New order</span>
                        </a>
                    </li>
                                        
                                        <li {% if active_menu == "services" %} class="sidebar_menu_item active" {% endif %} class="sidebar_menu_item ">
                        <a href="/services" class="sidebar_link">
                            <span class="icon">
                                                                <i class="far fa-list-ul m-icon"></i>
                                                            </span>
                            <span class="text">Services</span>
                        </a>
                    </li>
                                        
                                        <li {% if active_menu == "orders" %} class="sidebar_menu_item active" {% endif %} class="sidebar_menu_item ">
                        <a href="/orders" class="sidebar_link">
                            <span class="icon">
                                                                <i class="far fa-box-heart m-icon"></i>
                                                            </span>
                            <span class="text">Orders</span>
                        </a>
                    </li>
                                        
                                        <li {% if active_menu == "addfunds" %} class="sidebar_menu_item active" {% endif %} class="sidebar_menu_item ">
                        <a href="/addfunds" class="sidebar_link">
                            <span class="icon">
                                                                <i class="far fa-wallet m-icon"></i>
                                                            </span>
                            <span class="text">Add funds</span>
                        </a>
                    </li>
                                        
                                        <li {% if active_menu == "tickets" %} class="sidebar_menu_item active" {% endif %} class="sidebar_menu_item ">
                        <a href="/tickets" class="sidebar_link">
                            <span class="icon">
                                                                <i class="far fa-headset m-icon"></i>
                                                            </span>
                            <span class="text">Tickets</span>
                        </a>
                    </li>
                                        
                    
                                        
                    
                                        
                    
                                        
                    
                                        
                    
                                        
                                        <li {% if active_menu == "massorder" %} class="sidebar_menu_item active" {% endif %} class="sidebar_menu_item ">
                        <a href="/massorder" class="sidebar_link">
                            <span class="icon">
                                                                <i class="far fa-box-full m-icon"></i>
                                                            </span>
                            <span class="text">Mass order</span>
                        </a>
                    </li>
                                                        </ul>
                <div class="showmore__wrap">
                    <div class="text-center">
                        <button class="showmore__btn" onclick="showmoreButton()">
                            <span class="text">Show more</span>
                            <span class="icon">
                                <i class="fas fa-angle-double-down"></i>
                            </span>
                        </button>
                    </div>
                    <div class="show_more_menu d-none" id="showmore_menu">
                        <ul class="sidebar_menu">
                            
                            
                                                        
                            
                                                        
                            
                                                        
                            
                                                        
                            
                                                        
                                                       <!-- <li class="sidebar_menu_item ">
                                <a href="/dashboard" class="sidebar_link">
                                    <span class="icon">
                                                                                <i class="fas fa-columns m-icon"></i>
                                                                            </span>
                                    <span class="text">Dashboard</span>
                                </a>
                            </li> -->
                                                        
                                                       <li {% if active_menu == "child-panels" %} class="sidebar_menu_item active" {% endif %} class="sidebar_menu_item ">
                                <a href="/child-panels" class="sidebar_link">
                                    <span class="icon">
                                                                                <i class="fas fa-child m-icon"></i>
                                                                            </span>
                                    <span class="text">Child panel</span>
                                </a>
                            </li>
                                                        
                                                       <li {% if active_menu == "api" %} class="sidebar_menu_item active" {% endif %} class="sidebar_menu_item ">
                                <a href="/api" class="sidebar_link">
                                    <span class="icon">
                                                                                <i class="far fa-code m-icon"></i>
                                                                            </span>
                                    <span class="text">API</span>
                                </a>
                            </li>
                                                        
                                                        <li {% if active_menu == "refer" %} class="sidebar_menu_item active" {% endif %} class="sidebar_menu_item ">
                                <a href="/refer" class="sidebar_link">
                                    <span class="icon">
                                                                                <i class="far fa-user-friends m-icon"></i>
                                                                            </span>
                                    <span class="text">Affiliates</span>
                                </a>
                            </li>
                                                        
                                                        <li {% if active_menu == "updates" %} class="sidebar_menu_item active" {% endif %} class="sidebar_menu_item ">
                                <a href="/updates" class="sidebar_link">
                                    <span class="icon">
                                                                                <i class="fas fa-pen-square m-icon"></i>
                                                                            </span>
                                    <span class="text">Updates</span>
                                </a>
                            </li>
                                                        
                            
                                                        
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="dashboard_content">
            <div class="dashboard_header">
                <button class="sidebartoglle_button2" onclick="sidebarToggler()">
                    <img src="https://cdn.smmsun.com/images/arrow-sidebar-right.png" class="img-fluid sidebar-open"
                        alt="arrow sidebar right">
                </button>
                <div class="dashboard_header_wraper">
                    <div class="dash-header mb-3 mt-3 d-flex justify-content-between">
                        <div class="align-self-center header_first">
                            <p>
                                <a href="/account">
                                    <img class="gender_img" src="https://cdn.smmsun.com/images/profile1.png"
                                        style="max-height: 40px;" alt=""></a>
                                You are currently on: 
                                <strong>
                                                                        {% if pagetitle %}  {{ pagetitle }}  {% else %} {{ title }} {% endif %}
                                                                    </strong>
                            </p>
                        </div>
                        <div class="align-self-center ml-auto header_mid">Total Orders <strong>{{totalorders}}</strong>
                        </div>
                        <div class="ml-auto header_last">
                            <div class="align-self-center ml-auto">Welcome, <strong>{{ user["username"]  }}!</strong> Your
                                balance is
                                <strong class="viewmoney">
                                   {{ user["balance"] }}
                                </strong>
                            </div>
                            <div class="logo_mob">
                                <a href="/">
                                    <img src="{{ site['logo'] }}" class="logo__mobile" alt="">
                                </a>
                            </div>
                            <ul class="align-self-center action-btn">
                             
                             
                                
                                <li class="setting">
                                    <a href="/account" class="setting"><i class="fas fa-cog" aria-hidden="true"></i></a>
                                </li>
                                <li><a href="/logout" class="logout"><i class="fas fa-sign-out-alt"
                                            aria-hidden="true"></i></a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            
            <script>
document.addEventListener("keydown", e => {
  // USE THIS TO DISABLE CONTROL AND ALL FUNCTION KEYS
  // if (e.ctrlKey || (e.keyCode>=112 && e.keyCode<=123)) {
  // THIS WILL ONLY DISABLE CONTROL AND F12
  if (e.ctrlKey || e.keyCode==123) {
    e.stopPropagation();
    e.preventDefault();
  }
});
</script>


