<!DOCTYPE html>
	{% for lang in site['languages'] %}
		{% if lang['active'] %}
			<html lang="{{ lang['code'] }}">
			{% endif %}
		{% endfor %}

		<head>
			<base href="{{ site['url'] }}">


			<title>
				{% if pagetitle %}
					{{ pagetitle }}
				{% else %}
					{{ title }}
				{% endif %}
			</title>
			<meta property="og:title" content="{% if pagetitle %} {{ pagetitle }} {% else %} {{ title }} {% endif %}"/>
			<meta charset="utf-8">
			<meta http-equiv="X-UA-Compatible" content="IE=edge">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<meta name="keywords" content="{% if pagekeywords %} {{ pagekeywords }} {% else %} {{ site[" keywords"]}} {% endif %}">
			<meta name="description" content="{% if pagedescription %} {{ pagedescription }} {% else %} {{ site['description'] }} {% endif %}">
			<meta property="og:description" content="{% if pagedescription %} {{ pagedescription }} {% else %} {{ site['description'] }} {% endif %}"/>
			{% if site['favicon'] %}
				<link rel="shortcut icon" type="image/ico" href="{{ site['favicon'] }}"/>
			{% endif %}


			<script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert/2.1.0/sweetalert.min.js"></script>
<link rel="stylesheet" type="text/css" href="/app/views/SMMSUN-New-V2/css/xxts6jj9jyyjimp0_wzaech.css">
<link rel="stylesheet" type="text/css" href="/app/views/SMMSUN-New-V2/css/swiper-bundle.min_phxsaq.css">
 <link rel="stylesheet" type="text/css" href="/app/views/SMMSUN-New-V2/css/xxts6jj9jyyjimp0.css">
        <link rel="stylesheet" type="text/css" href="/app/views/SMMSUN-New-V2/css/t7cd5r4rroirox6e.css">
        <link rel="stylesheet" type="text/css" href="https://cdn.mypanel.link/libs/bootstrap-datetimepicker/4.17.47/bootstrap-datetimepicker.min.css">
        <link rel="stylesheet" type="text/css" href="https://cdn.mypanel.link/css/font-awesome/css/all.min.css">
        <link rel="stylesheet" type="text/css" href="https://cdn.mypanel.link/global/tp2jssyocan4ndm1.css">
        <script>
        window.modules = {};
    </script>
    
			{{ headerCode }}
		</head>
		{% if user['auth'] %}

		
<body oncontextmenu="return false" class="auth" id="body" >
        <script>
        if (localStorage.getItem('smmstoreCurrentMode')) {
            const bodyFire2 = document.getElementById('body');
            bodyFire2.classList.add('nightmode');
        }
    </script>
    <div class="full_dashboard" id="fullDashboard">
        <div class="dashboard_sidebar">
            <button class="sidebartoglle_button" onclick="sidebarToggler()">
                <img src="https://cdn.smmsun.com/images/arrow-sidebar-left.png" class="img-fluid sidebar-open"
                    alt="arrow-sidebar-left">
            </button>
            <div class="bg_sidebars">
                <img src="https://cdn.smmsun.com/images/sidebar-effect-bg.png" alt="">
            </div>
            <div class="sidebar-logo">
                
																    
																	<a target="_self" href="/">
																		{% if site["logo"] %}
																			<img style="max-width:200px;" src="{{ site['logo'] }}" alt="" title="">
																		{% else %}
																			<span style="text-transform: ">
																				<span style="font-size: 24px">
																					<span style="letter-spacing: 1.0px">
																						<span style="line-height: 0px">
																							<strong style="font-weight: bold">{{ site["site_name"]
                                      }}</strong>
																						</span>
																					</span>
																				</span>
																			</span>
																		{% endif %}
																	</a>
            </div>
            <div class="user_box">
                <div class="user__status">
                                        NEW
                                    </div>
                <div class="box_avatar">
                    <img src="https://cdn.smmsun.com/images/avatar.png" class="img-fluid" alt="">
                </div>
                <h4>{{ user["username"]  }}</h4>
                <p>
                    {{ user["balance"] }}
                </p>
            </div>
            <div class="sidebar_menu_wrap">
                <ul class="sidebar_menu">
                    
                                        <li {% if active_menu == "neworder" %} class="sidebar_menu_item active" {% endif %} class="sidebar_menu_item ">
