{% include 'header.twig' %}


<main class="main_content">
                <div class="container-fluid">
    <div class="row">
        <div class="col-lg-12 col-md-12 col-12">
            <div class="card card_type_3">
                <div class="card-header">
                    <h4>@{{ user['username'] }}</h4>
                </div>
                <div class="card-body">
                                        
                                  {% if error %}
        <div class="alert alert-dismissible alert-danger">
          <button type="button" class="close" data-dismiss="alert">×</button>
          {{ errorText }}
        </div>
      {% endif %}
      {% if success %}
        <div class="alert alert-dismissible alert-success">
          <button type="button" class="close" data-dismiss="alert">×</button>
          {{ successText }}
        </div>
      {% endif %}              
                        <div class="account__items">
                            <form  method="post" action="">
                                <div class="row">
                                    <div class="col-12">
                                                                            </div>
                                    <div class="col-lg-4 col-md-4 col-12">
                                        <div class="form-group">
                                            <label for="current" class="control-label">Current password</label>
                                            <input type="password" class="form-control" id="current"
                                                name="current_password">
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-12">
                                        <div class="form-group">
                                            <label for="new" class="control-label">New password</label>
                                            <input type="password" class="form-control" id="new"
                                                name="password">
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-12">
                                        <div class="form-group">
                                            <label for="confirm" class="control-label">Confirm new password</label>
                                            <input type="password" class="form-control" id="confirm"
                                                name="confirm_password">
                                        </div>
                                    </div>
                                    
                                    <div class="col-12">
                                        <button type="submit" class="btn btn-primary w-100">Change password</button>
                                    </div>
                                </div>
                            </form>
                        </div>

                        <div class="account__items">
                            <form id="changeEmailForm" method="post" action="">
                                <div id="changeEmailError"
                                    class="error-summary alert alert-dismissible alert-danger hidden">
                                </div>
                                <div class="row">
                                    <div class="col-lg-4 col-md-4 col-12">
                                        <div class="form-group">
                                            <label for="current-email">Current email</label>
                                            <span class="form-control" id="current-email" disabled>{{ user['email'] }}</span>
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-12">
                                        <div class="form-group">
                                            <label for="new-email">New email</label>
                                            <input type="email" class="form-control" id="new-email"
                                                name="email">
                                        </div>
                                    </div>
                                    <div class="col-lg-4 col-md-4 col-12">
                                        <div class="form-group">
                                            <label for="current-password">Current password</label>
                                            <input type="password" class="form-control" id="current-password"
                                                name="password">
                                        </div>
                                    </div>
                                </div>
                                
                                <button type="submit" class="btn btn-primary w-100" id="changeEmailSubmitBtn">Change email</button>
                            </form>
                        </div>

