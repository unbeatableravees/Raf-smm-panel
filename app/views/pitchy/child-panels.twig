{% include 'header.twig' %}
  <div class="wrapper-content__body">
 <div class="well well-float">
<div class="row">
<div class="col-md-12">
<div class="well mt-4">
 

 <div class="add-funds__form">
        <div class="bg"></div>
        <div class="divider-top"></div>
        <div class="divider-bottom"></div>
        <div class="container">
            <div class="row add-funds__form-alignment">
                 
{% if contentText %}
<div class="card mt-2 mb-3">
{{ contentText }}
</div>
{% endif %}
                    <div class="component_card">
                        <div class="card">
{% if error %}
      <div class="alert alert-dismissible alert-danger">
          <button type="button" class="close" data-dismiss="alert">×</button>
        {{ errorText }}
      </div>
    {% endif %}  

    {% if data["childpanel"]["success"] == 1 %}
      <div class="alert alert-dismissible alert-success">
<p>You have successfully ordered your Child Panel.</p>
<strong> Order ID: </strong> {{ data['childpanel']['id'] }} <br>
<strong> Domain: </strong> {{ data['childpanel']['link'] }} <br>
<strong> Quantity: </strong> {{ data['childpanel']['quantity'] }} <br>
<strong> Remaining balance: </strong> {{ data['childpanel']['balance'] }} <br>
</div>



{% endif %}
    <form name="contact-form" action="child-panels" method="post">
    <div class="form-group">
    <label for="Domain">Domain</label>
    <input type="text" class="form-control" name="panel_domain" placeholder="example.com" required>
    </div>
						<div class="component_alert_dns">
								<div class="">
		 <div class="alert alert-info " id="orderNote">
            <p class="help-block" style="margin-bottom: 5px">Please visit your registrar's dashboard to change nameservers to:</p><ul style="color: #737373; padding-left: 20px"><li>{{ site['ns1'] }}</li><li>{{ site['ns2'] }}</li></ul>        </div>
								</div>
							</div>
							</div>
							</div>
							</div>
							</div>
							</div>
							</div>
				<div class="well mt-4">			
		
		<div class="form-group">
<label class="Domain" for="currency">Panel Currency</label>
			
		<select class="form-control" name="panel_currency" required>
{{ child_panel_currencies }}
</select>
    </div>
	
    <input type="text" id="createorderform-username" class="form-control" name="username" aria-required="true" value="">
						
							<div class="form-group">
								<label class="control-label" for="createorderform-password">Admin Password</label>
								<input type="password" id="createorderform-password" class="form-control" name="password" aria-required="true">
							</div>
							<div class="form-group">
								<label class="control-label" for="createorderform-password_confirm">Confirm Password</label>
								<input type="password" id="createorderform-password_confirm" class="form-control" name="password_confirm" aria-required="true">
	
		
<div class="form-group">
<label for="charge" class="control-label"> Price per month</label>
<input type="text" class="form-control" value="{{site_base_currency_symbol}}{{" "}}{{site["childpanel_price"]}}" readonly>
</div>
<button type="submit" class="btn btn-block btn-primary" name="submit" value="Submit" id="submit_form">Submit Order</button>
</form>
</div></div></div>

<div class="col">

<div class="orders-history__margin-table">
<div class="table-bg component_table ">
<br>
<div class="table-responsive custom-table">

            <table class="table ">
              <thead>
                        <tr>
              <th>#</th>
              <th>Domain</th>
              <th>Panel Currency</th>
              <th class="nowrap">Purchased On</th>
              <th class="nowrap">Status</th>
              <th>Renewal Date</th>
            </tr>
          </thead>
          <tbody>

{% for logs in chilpanel_logs %}
<tr>
<td>{{ logs['id'] }}</td>
<td>{{ logs['domain'] }}</td>
<td>{{ logs['child_panel_currency'] }}</td>
<td class="nowrap">{{ logs['created_on'] }}</td>
<td class="nowrap">
{{ logs["child_panel_status"] }}
</td>
<td>{{logs["renewal_date"] }}</td>
</tr>
{% endfor %}
</tbody>
</table>
      </div>
  </div></div></div>

   </div></div>
</div>
<div class="container-fluid">
					<div class="row add-funds__form-alignment">
						<div class="col-lg-12">
							<div class="component_card">
							    {% if contentText2 %}
<div class="card mt-3 mb-3">
{{ contentText2 }}
</div>
{% endif %}</div>
							</div>
						</div>
					</div>
				</div>
							</div>
							</div>
							</div>
							</div>
{% include 'footer.twig' %}

