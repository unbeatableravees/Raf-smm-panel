.order-success-card {
    width:380px;
    background-color: #fff;
    border-radius:10px;
    position: fixed;
    top:0;
    left:50%;
    padding:0 30px 30px;
    
    color:#333;
    transform: translate(-50%,-50%) scale(0.1);
    visibility: hidden;
    transition :transform 0.4s,top 0.4s;
    box-shadow:0 20px 50px rgba(0,0,0,0.2);
    z-index:9999;
    font-family: 'Lobster', cursive;
}
.order-success-card-active {
    visibility:visible;
    top:50%;
    transform: translate(-50%,-50%) scale(1);
}

.order-success-card img {
    width:100px;
    margin-top: -50px;
    border-radius:50%;
    box-shadow : 0 2px 5px rgba(0,0,0,0.2);
}
.order-success-card h2 {
    font-size: 20px;
    font-weight:500;
    margin : 30px 0 10px;
    text-align:center;
    font-family: 'Lobster', cursive;
    
}
.order-success-card button {
    width:100%;
    margin-top:20px;
    padding:10px 0;
    background: #6fd649;
    outline:none;
    border:0;
    border-radius:6px;
    font-size:18px;
    cursor:pointer;
    box-shadow : 0 5px 5px rgba(0,0,0,0.2);
}
.order-success-card .order-details p {
    padding:10px;
}
.order-success-card .order-details .paid-amount {
    float:left;
    background-color: rgba(120, 67, 219,0.2);
    padding : 4px;
    border-radius: 4px;
    margin-left:-10px;
}
.order-success-card .order-details .quantity {
    float:right;
    background-color:rgba(224, 20, 76,0.2);
    padding : 4px;
    border-radius: 4px;
    margin-right:-10px;
}
.order-success-card .user-details {
padding:10px;
background: rgba(111, 214, 73,0.2);
margin-top:25px;
border-radius: 4px;
}

